# Copie este arquivo para .env (cp .env.example .env) e ajuste se necessário.
# Ver docs/floci.md para detalhes de cada variável.

# --- Variáveis do SDK/CLI da AWS (apontam para o Floci local) ---
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# ID de conta simulado pelo Floci.
# Se tiver exatamente 12 dígitos, o Floci isola os recursos por essa conta.
AWS_ACCOUNT_ID=000000000000

# --- Variáveis do container Floci (docker-compose.yml) ---

# Porta exposta pelo Floci no host
FLOCI_PORT=4566

# Modo de armazenamento: memory | persistent | hybrid | wal
FLOCI_STORAGE_MODE=hybrid

# Imagem/tag do Floci.
# Use a variante "-compat" (ex: floci/floci:latest-compat) se os scripts em
# ./init precisarem de AWS CLI ou boto3 embutidos na imagem.
FLOCI_IMAGE=floci/floci:latest
