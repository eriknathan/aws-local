                <mxCell id="c4-b" value="Valida a identidade e confere&lt;br&gt;se o solicitante é o dono da tarefa" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
