                    <mxGeometry x="1455" y="305" width="44" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="ddb-l" value="&lt;b&gt;DynamoDB · flowqueue-orders&lt;/b&gt;&lt;br&gt;Estado da tarefa, proprietário, chave S3 + VersionId&lt;br&gt;Escritas condicionais · PITR" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
