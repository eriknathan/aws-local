                <mxCell id="e-ep-ifc" value="ENI + DNS privado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#8C4FFF;fontColor=#8C4FFF;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.69;entryDx=0;entryDy=0;" parent="1" source="ep" target="ifc" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="foot1" value="Caminho de rede, em uma frase por caso" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4298BC;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontColor=#4298BC;fontSize=13;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="35" y="1240" width="940" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="foot1t" value="&lt;b&gt;Cliente → aplicação:&lt;/b&gt; CloudFront → IGW → ALB (sub-redes públicas) → EC2 do frontend (sub-rede privada), sempre por SG, nunca por IP público.&lt;br&gt;&lt;b&gt;EC2 → serviço AWS:&lt;/b&gt; VPC endpoint, sem sair para a Internet — é o caminho de SQS, DynamoDB, S3, SSM e CloudWatch.&lt;br&gt;&lt;b&gt;EC2 → API externa:&lt;/b&gt; NAT da própria AZ → IGW. Perder uma AZ não tira a saída da outra.&lt;br&gt;&lt;b&gt;Operador → EC2:&lt;/b&gt; Session Manager pelo agente; não existe porta 22 aberta nem bastion.&lt;br&gt;&lt;b&gt;Backend:&lt;/b&gt; não tem regra de entrada em nenhum caminho — só conexões que ele mesmo inicia." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
                    <mxGeometry x="55" y="1276" width="900" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="foot2" value="Desenhado x aplicado hoje" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CE8C55;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontColor=#CE8C55;fontSize=13;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="995" y="1240" width="970" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="foot2t" value="&lt;b&gt;Já no Terraform:&lt;/b&gt; VPC, 6 sub-redes, IGW, 2 NAT, route tables, ALB + target group, 2 ASGs com launch template, SQS + DLQ, DynamoDB, S3 com Object Lock, Parameter Store e IAM por camada.&lt;br&gt;&lt;b&gt;Ainda proposto&lt;/b&gt; (marcado com &lt;i&gt;itálico&lt;/i&gt; no desenho): WAF, HTTPS/ACM, restrição da origem por prefix list e cabeçalho, VPC endpoints, políticas de escala e alarmes com SNS.&lt;br&gt;&lt;b&gt;Desligado no ambiente local:&lt;/b&gt; CloudFront e o listener do ALB, por limitações do Floci — ver README." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
                    <mxGeometry x="1015" y="1276" width="930" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="foot" value="Proposta de arquitetura · itálico marca o que ainda não existe no Terraform · fluxo de negócio na aba 02 · autorização e permissões na aba 03" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#6B7885;" parent="1" vertex="1">
                    <mxGeometry x="35" y="1440" width="1930" height="26" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
