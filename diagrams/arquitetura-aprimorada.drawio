                    <mxGeometry x="35" y="16" width="1930" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="03 · Como o cliente acompanha a tarefa e baixa o recibo, o que cada papel pode fazer e o que precisa ser testado." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#6B7885;" parent="1" vertex="1">
