                <mxCell id="c5-t" value="&lt;b&gt;⑤ DynamoDB&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#232F3E;" parent="1" vertex="1">
                    <mxGeometry x="1226" y="146" width="160" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="c5-b" value="GetItem: estado, proprietário,&lt;br&gt;chave do recibo e VersionId" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
