                <mxCell id="s3" value="" style="sketch=0;html=1;outlineConnect=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#7AA116;gradientColor=none;strokeColor=none;aspect=fixed;" parent="1" vertex="1">
