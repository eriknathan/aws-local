                <mxCell id="c5-ic" value="" style="sketch=0;html=1;outlineConnect=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#3B48CC;gradientColor=none;strokeColor=none;aspect=fixed;" parent="1" vertex="1">
                    <mxGeometry x="1184" y="144" width="34" height="34" as="geometry"/>
