                <mxCell id="albband" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7952CC;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#3F4A56;fontSize=12;fontFamily=Arial;dashed=1;dashPattern=6 6;" parent="1" vertex="1">
                    <mxGeometry x="575" y="424" width="125" height="430" as="geometry"/>
                </mxCell>
                <mxCell id="leg" value="Leitura do desenho" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#879196;fontSize=12;fontFamily=Arial;dashed=1;dashPattern=6 6;" parent="1" vertex="1">
                    <mxGeometry x="165" y="560" width="180" height="340" as="geometry"/>
                </mxCell>
                <mxCell id="legt" value="Roxo: rede e borda&lt;br&gt;Rosa: mensageria&lt;br&gt;Azul: DynamoDB&lt;br&gt;Verde: recibos no S3&lt;br&gt;Vermelho: security group&lt;br&gt;Cinza: saída pela Internet&lt;br&gt;&lt;br&gt;Faixa roxa tracejada: um único ALB, presente nas duas AZs.&lt;br&gt;&lt;br&gt;Tracejado: agrupamento lógico ou caminho ainda proposto.&lt;br&gt;&lt;br&gt;&lt;i&gt;Itálico&lt;/i&gt;: ainda não existe no Terraform.&lt;br&gt;&lt;br&gt;Sem setas de negócio aqui: elas estão na aba 02." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
                    <mxGeometry x="180" y="592" width="150" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="ep" value="VPC Endpoints &lt;i&gt;(propostos)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C4FFF;align=left;verticalAlign=top;spacingLeft=38;spacingTop=6;fontColor=#8C4FFF;fontSize=12;fontFamily=Arial;dashed=1;dashPattern=6 6;" parent="1" vertex="1">
                    <mxGeometry x="420" y="915" width="925" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="epicon" value="" style="sketch=0;html=1;outlineConnect=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.vpc;fillColor=#8C4FFF;gradientColor=none;strokeColor=none;aspect=fixed;" parent="1" vertex="1">
                    <mxGeometry x="421" y="916" width="30" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="eptext" value="&lt;b&gt;Gateway&lt;/b&gt; (rota na route table privada, sem custo por hora): S3 e DynamoDB.&lt;br&gt;&lt;b&gt;Interface&lt;/b&gt; (ENI na sub-rede, DNS privado, SG liberando 443): SQS, ssm, ssmmessages, ec2messages — um por AZ.&lt;br&gt;Com eles, chamada de EC2 a serviço AWS não passa pelo NAT nem pela Internet; política de endpoint + IAM limitam recurso e ação." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
                    <mxGeometry x="445" y="952" width="880" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="routes" value="&lt;b&gt;Rotas e portas&lt;/b&gt;&lt;br&gt;Uma route table pública para as duas sub-redes públicas (0.0.0.0/0 → IGW) e uma route table privada por AZ (0.0.0.0/0 → NAT da própria AZ), compartilhada pelo frontend e pelo backend daquela zona.&lt;br&gt;VPC com DNS support e DNS hostnames habilitados. ALB: target group HTTP com health check da aplicação; o ASG do frontend usa health check ELB. Backend não recebe conexão de entrada: só abre conexões de saída." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacingLeft=0;spacingTop=6;fontColor=#3F4A56;fontSize=11;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="420" y="1050" width="925" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="managed" value="Serviços regionais · fora da VPC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#879196;fontSize=12;fontFamily=Arial;dashed=1;dashPattern=6 6;" parent="1" vertex="1">
                    <mxGeometry x="1420" y="215" width="510" height="940" as="geometry"/>
                </mxCell>
                <mxCell id="gw" value="Alcançados por &lt;b&gt;gateway endpoint&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C4FFF;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#8C4FFF;fontSize=12;fontFamily=Arial;dashed=1;dashPattern=6 6;" parent="1" vertex="1">
                    <mxGeometry x="1435" y="260" width="480" height="250" as="geometry"/>
                </mxCell>
