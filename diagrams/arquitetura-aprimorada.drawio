                </mxCell>
                <mxCell id="resp" value="&lt;b&gt;Resposta da API:&lt;/b&gt; devolve o estado; se COMPLETED e o solicitante for o dono, devolve também a URL assinada com o VersionId. Sem autorização não há assinatura — a URL é o último passo, nunca o primeiro." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
                    <mxGeometry x="50" y="332" width="1910" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="mtitle" value="&lt;b&gt;Permissões por responsabilidade&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#232F3E;" parent="1" vertex="1">
                    <mxGeometry x="50" y="382" width="800" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="mh0" value="&lt;b&gt;Papel&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#C9D3DD;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=6;fontColor=#232F3E;fontSize=12;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="50" y="416" width="300" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="mh1" value="&lt;b&gt;Pode — o mínimo necessário&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#C9D3DD;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=6;fontColor=#232F3E;fontSize=12;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="350" y="416" width="800" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="mh2" value="&lt;b&gt;Não pode&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#C9D3DD;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=6;fontColor=#232F3E;fontSize=12;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="1150" y="416" width="810" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="mr0a" value="&lt;b&gt;Frontend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDE4EB;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=6;fontColor=#232F3E;fontSize=12;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="50" y="456" width="300" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="mr0b" value="sqs:SendMessage na fila principal · dynamodb:GetItem para estado e dono · s3:GetObject no prefixo de recibos, apenas para assinar a URL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDE4EB;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=6;fontColor=#3F4A56;fontSize=11;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="350" y="456" width="800" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="mr0c" value="Não consome a fila, não grava recibo, não altera estado de tarefa nem configuração de bucket" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDE4EB;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=6;fontColor=#3F4A56;fontSize=11;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="1150" y="456" width="810" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="mr1a" value="&lt;b&gt;Backend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#DDE4EB;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=6;fontColor=#232F3E;fontSize=12;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="50" y="534" width="300" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="mr1b" value="sqs:ReceiveMessage / DeleteMessage / ChangeMessageVisibility · dynamodb leitura e escrita condicional · s3:PutObject e leitura para reconciliar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#DDE4EB;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=6;fontColor=#3F4A56;fontSize=11;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="350" y="534" width="800" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="mr1c" value="Não tem s3:PutObjectRetention nem BypassGovernanceRetention: não consegue enfraquecer a retenção de 365 dias" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#DDE4EB;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=6;fontColor=#3F4A56;fontSize=11;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="1150" y="534" width="810" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="mr2a" value="&lt;b&gt;Operação&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDE4EB;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=6;fontColor=#232F3E;fontSize=12;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="50" y="612" width="300" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="mr2b" value="Session Manager nas instâncias · leitura de logs e métricas · alteração de configuração de bucket e retenção em papel separado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDE4EB;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=6;fontColor=#3F4A56;fontSize=11;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="350" y="612" width="800" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="mr2c" value="Não usa as credenciais da aplicação; não há SSH nem RDP abertos para chegar às instâncias" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDE4EB;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=6;fontColor=#3F4A56;fontSize=11;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="1150" y="612" width="810" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="mr3a" value="&lt;b&gt;Bucket de recibos&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#DDE4EB;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=6;fontColor=#232F3E;fontSize=12;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="50" y="690" width="300" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="mr3b" value="Política do bucket exige COMPLIANCE no PutObject e nega tentativa de reduzir o modo de retenção &lt;i&gt;(proposto)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#DDE4EB;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=6;fontColor=#3F4A56;fontSize=11;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="350" y="690" width="800" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="mr3c" value="Nem o root apaga ou sobrescreve uma versão dentro da janela de 365 dias — inclusive por engano" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#DDE4EB;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=6;fontColor=#3F4A56;fontSize=11;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="1150" y="690" width="810" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="v1" value="Testes de falha" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CE8C55;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontColor=#CE8C55;fontSize=13;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="50" y="800" width="620" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="v1t" value="Publicar com timeout na SQS e conferir que o cliente não recebe 202.&lt;br&gt;Entregar a mesma mensagem duas vezes: um único recibo, uma única versão.&lt;br&gt;Matar o worker depois do PutObject e antes do commit; reprocessar deve reconciliar.&lt;br&gt;Deixar a visibilidade expirar e acompanhar o redrive para a DLQ." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
                    <mxGeometry x="68" y="836" width="585" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="v2" value="Testes de segurança" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CE8C55;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontColor=#CE8C55;fontSize=13;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="690" y="800" width="620" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="v2t" value="Pedir a tarefa de outro usuário: precisa negar antes de qualquer assinatura.&lt;br&gt;Usar URL expirada e URL de outra versão.&lt;br&gt;Acessar o ALB direto, sem passar pelo CloudFront.&lt;br&gt;Tentar apagar uma versão dentro da retenção e subir objeto com retenção menor." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
                    <mxGeometry x="708" y="836" width="585" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="v3" value="Recuperação e disponibilidade" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CE8C55;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontColor=#CE8C55;fontSize=13;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="1330" y="800" width="630" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="v3t" value="Restaurar a tabela por PITR e comparar com os recibos existentes.&lt;br&gt;Derrubar uma AZ: ALB e os dois ASGs seguem na AZ restante, com capacidade para N-1.&lt;br&gt;Health check da aplicação no target group; ASG do frontend com health check ELB.&lt;br&gt;Object Lock protege o recibo, mas não substitui um plano de recuperação do sistema." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
                    <mxGeometry x="1348" y="836" width="595" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="foot3" value="Referências AWS: S3 Object Lock · Restrict access to Application Load Balancers · Scaling policy based on Amazon SQS · itálico marca o que ainda não existe no Terraform" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#6B7885;" parent="1" vertex="1">
                    <mxGeometry x="35" y="1000" width="1930" height="26" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>