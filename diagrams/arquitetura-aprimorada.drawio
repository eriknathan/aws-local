                <mxCell id="s3" value="&lt;b&gt;③ Responde 202 + taskId&lt;/b&gt;&lt;br&gt;só após confirmação da fila" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=6;fontColor=#232F3E;fontSize=11;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="690" y="179" width="180" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="s4" value="&lt;b&gt;④ ReceiveMessage&lt;/b&gt;&lt;br&gt;long polling · visibilidade inicia" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=6;fontColor=#232F3E;fontSize=11;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="690" y="399" width="180" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="s5" value="&lt;b&gt;⑤ Lease + PROCESSING&lt;/b&gt;&lt;br&gt;escrita condicional por taskId" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B48CC;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=6;fontColor=#232F3E;fontSize=11;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="890" y="509" width="180" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="s6" value="&lt;b&gt;⑥ PutObject do recibo&lt;/b&gt;&lt;br&gt;chave estável · If-None-Match: *" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=6;fontColor=#232F3E;fontSize=11;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="619" width="180" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="s7" value="&lt;b&gt;⑦ COMPLETED + VersionId&lt;/b&gt;&lt;br&gt;e checksum do recibo" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B48CC;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=6;fontColor=#232F3E;fontSize=11;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="1290" y="509" width="180" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="s8" value="&lt;b&gt;⑧ DeleteMessage&lt;/b&gt;&lt;br&gt;último passo, nunca antes" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D62484;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=6;fontColor=#232F3E;fontSize=11;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="1490" y="289" width="180" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="dlq" value="&lt;b&gt;DLQ&lt;/b&gt;&lt;br&gt;após maxReceiveCount" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D62484;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=6;fontColor=#232F3E;fontSize=11;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="1720" y="289" width="180" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#C02976;fontColor=#C02976;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s1" target="s2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#C02976;fontColor=#C02976;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s2" target="s3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#C02976;fontColor=#C02976;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s2" target="s4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#3569B0;fontColor=#3569B0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s4" target="s5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#648B20;fontColor=#648B20;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s5" target="s6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#3569B0;fontColor=#3569B0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s6" target="s7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#C02976;fontColor=#C02976;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s7" target="s8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="efail" value="falha antes de ⑧ · a mensagem reaparece após a visibilidade e o ciclo recomeça em ④" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#C0392B;fontColor=#C0392B;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="s7" target="s2" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1380" y="740"/>
                            <mxPoint x="580" y="740"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="edlq" value="entrega repetida além do limite" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#C0392B;fontColor=#C0392B;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="s2" target="dlq" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="580" y="262"/>
                            <mxPoint x="1810" y="262"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="note-read" value="&lt;b&gt;Como ler:&lt;/b&gt; cada caixa fica na raia do serviço que executa a operação — quem inicia ⑤, ⑥, ⑦ e ⑧ é sempre o worker do backend." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#6B7885;" parent="1" vertex="1">
                    <mxGeometry x="290" y="745" width="900" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="note-idem" value="&lt;b&gt;Reentrega cai em ⑤:&lt;/b&gt; se já existe lease vivo ou estado COMPLETED para o taskId, o worker não repete ⑥ — reconcilia o recibo existente e segue para ⑧." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
                    <mxGeometry x="890" y="775" width="760" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="b1" value="Por que repetir é seguro" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4298BC;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontColor=#4298BC;fontSize=13;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="40" y="830" width="620" height="178" as="geometry"/>
                </mxCell>
                <mxCell id="b1t" value="&lt;b&gt;Chave determinística:&lt;/b&gt; o recibo de um taskId sempre tem a mesma chave no S3; com If-None-Match: * a segunda tentativa não cria versão nova.&lt;br&gt;&lt;b&gt;Escrita condicional:&lt;/b&gt; só um worker ganha o lease; o outro descobre que a tarefa já está em curso.&lt;br&gt;&lt;b&gt;Efeito colateral por último:&lt;/b&gt; o DeleteMessage só acontece depois do recibo gravado e do estado confirmado.&lt;br&gt;&lt;b&gt;Não há transação única&lt;/b&gt; entre SQS, DynamoDB e S3 — a ordem dos passos é o que dá a garantia." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
                    <mxGeometry x="58" y="866" width="585" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="b2" value="Tempos e limites" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4298BC;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontColor=#4298BC;fontSize=13;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="690" y="830" width="620" height="178" as="geometry"/>
                </mxCell>
                <mxCell id="b2t" value="&lt;b&gt;Visibilidade&lt;/b&gt; maior que o pior caso de processamento, estendida com ChangeMessageVisibility em tarefa longa.&lt;br&gt;&lt;b&gt;Lease&lt;/b&gt; com expiração no DynamoDB, para que a queda de um worker não trave o taskId para sempre.&lt;br&gt;&lt;b&gt;Retry&lt;/b&gt; com backoff; depois de maxReceiveCount a mensagem vai para a DLQ, que retém por mais tempo que a principal.&lt;br&gt;&lt;b&gt;Encerramento de instância:&lt;/b&gt; drenar a tarefa em andamento antes de terminar." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
                    <mxGeometry x="708" y="866" width="585" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="b3" value="Sinais de problema" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4298BC;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontColor=#4298BC;fontSize=13;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="1340" y="830" width="620" height="178" as="geometry"/>
                </mxCell>
                <mxCell id="b3t" value="&lt;b&gt;Idade da mensagem mais antiga&lt;/b&gt; subindo: o backlog cresce mais rápido do que o processamento.&lt;br&gt;&lt;b&gt;DLQ &gt; 0:&lt;/b&gt; falha que se repete; investigar antes de qualquer redrive.&lt;br&gt;&lt;b&gt;Erro de PutObject ou de escrita condicional:&lt;/b&gt; possível divergência entre recibo e estado.&lt;br&gt;&lt;b&gt;Logs correlacionados por taskId&lt;/b&gt; são o que torna cada um desses sinais investigável. &lt;i&gt;(alarmes ainda propostos)&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
                    <mxGeometry x="1358" y="866" width="585" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="foot2" value="Comportamento proposto para a aplicação; o Terraform provisiona a infraestrutura, não a lógica acima. Topologia de rede na aba 01 · autorização e permissões na aba 03" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#6B7885;" parent="1" vertex="1">
                    <mxGeometry x="35" y="1020" width="1930" height="26" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="access-controls" name="03 · Acesso e controles">
