                <mxCell id="c3-b" value="Origem restrita ao CloudFront&lt;br&gt;prefix list + cabeçalho &lt;i&gt;(proposto)&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
