                <mxCell id="c6" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6DDE5;align=left;verticalAlign=top;spacingLeft=0;spacingTop=6;fontColor=#3F4A56;fontSize=12;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="1450" y="130" width="230" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="c6-t" value="&lt;b&gt;⑥ API assina a URL&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#232F3E;" parent="1" vertex="1">
                    <mxGeometry x="1464" y="146" width="202" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="c6-b" value="Assinatura é local, com as credenciais&lt;br&gt;do papel: não há chamada ao S3" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
