        <mxCell id="ssm" parent="1" style="sketch=0;html=1;outlineConnect=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;fillColor=#D62484;gradientColor=none;strokeColor=none;aspect=fixed;" value="" vertex="1">
