        </mxCell>
        <mxCell id="e-sqs-dlq" edge="1" parent="1" source="sqs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#C02976;fontColor=#C02976;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="dlq" value="redrive por maxReceiveCount">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-s3-download" edge="1" parent="1" source="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#648B20;fontColor=#648B20;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="dluser" value="⑨ URL pré-assinada">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CE8C55;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontColor=#C46C1B;fontSize=13;fontFamily=Arial;" value="Fluxo de uma tarefa" vertex="1">
          <mxGeometry height="240" width="1030" x="35" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="flow-text" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" value="&lt;b&gt;①&lt;/b&gt; Cliente chama a API por HTTPS no CloudFront, com Web ACL e rate limit do WAF na frente.&lt;br&gt;&lt;b&gt;②&lt;/b&gt; CloudFront encaminha ao ALB: SG restrito à prefix list do CloudFront e cabeçalho de origem secreto (403 sem ele).&lt;br&gt;&lt;b&gt;③&lt;/b&gt; ALB distribui em HTTP interno para o ASG Frontend, presente nas duas AZs.&lt;br&gt;&lt;b&gt;④&lt;/b&gt; Frontend publica na fila e só então responde 202 + taskId, depois da confirmação da SQS.&lt;br&gt;&lt;b&gt;⑤&lt;/b&gt; Backend recebe por long polling; o DeleteMessage acontece apenas no fim do processamento bem-sucedido.&lt;br&gt;&lt;b&gt;⑥&lt;/b&gt; Backend adquire o lease por escrita condicional e trata reentrega como duplicata, não como nova tarefa.&lt;br&gt;&lt;b&gt;⑦&lt;/b&gt; Grava o recibo com chave determinística e If-None-Match: * — um recibo por tarefa, retido 365 dias.&lt;br&gt;&lt;b&gt;⑧&lt;/b&gt; Confirma COMPLETED + VersionId no DynamoDB; é esse estado que o Frontend lê para responder o cliente.&lt;br&gt;&lt;b&gt;⑨&lt;/b&gt; Download com URL pré-assinada de curta duração, liberada só para o proprietário da tarefa." vertex="1">
          <mxGeometry height="192" width="990" x="55" y="1366" as="geometry" />
        </mxCell>
        <mxCell id="recovery" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#429DB5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontColor=#429DB5;fontSize=13;fontFamily=Arial;" value="Falhas e recuperação" vertex="1">
          <mxGeometry height="240" width="575" x="1085" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="recovery-text" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" value="Falha entre ⑦ e ⑧: a mensagem volta após a visibilidade e o worker reconcilia o recibo já existente em vez de gravar outro.&lt;br&gt;Lease expirado: recuperável por escrita condicional; visibilidade extensível enquanto a tarefa avança.&lt;br&gt;Falha repetida: DLQ por maxReceiveCount, com alarme e redrive só depois da correção.&lt;br&gt;Perda de AZ: ALB e os dois ASGs seguem na AZ restante; capacidade dimensionada para N-1.&lt;br&gt;Testar: duplicata, falha parcial, perda de AZ, restauração por PITR, retenção mínima, acesso entre usuários e URL expirada.&lt;br&gt;O Object Lock protege o recibo, mas não substitui a recuperação do sistema completo." vertex="1">
          <mxGeometry height="192" width="535" x="1105" y="1366" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontColor=#879196;fontSize=13;fontFamily=Arial;" value="Leitura do desenho" vertex="1">
          <mxGeometry height="240" width="545" x="1680" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="legend-text" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" value="Cores: roxo = entrada web · rosa = mensageria · azul = DynamoDB · verde = recibos no S3 · cinza = rede.&lt;br&gt;Seta cheia: chamada de API, partindo de quem a inicia. Tracejado: associação, fluxo complementar ou redrive.&lt;br&gt;As setas de aplicação saem do grupo (ALB e ASGs), não de uma instância: valem para as duas AZs igualmente.&lt;br&gt;Caixas tracejadas que cruzam as AZs são um único recurso presente nas duas (ALB e cada ASG).&lt;br&gt;O usuário aparece duas vezes de propósito: a entrada ① e o download ⑨ são caminhos distintos.&lt;br&gt;Arco na linha indica cruzamento sem ligação." vertex="1">
          <mxGeometry height="192" width="505" x="1700" y="1366" as="geometry" />
        </mxCell>
        <mxCell id="footer" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#6B7885;" value="Proposta de arquitetura — não representa o estado aplicado. Terraform em flowqueue-tf/ · pendências de WAF, HTTPS/ACM, políticas de escala e alarmes estão em MELHORIAS.md." vertex="1">
          <mxGeometry height="26" width="2190" x="35" y="1578" as="geometry" />
        </mxCell>
        <mxCell id="asgfront" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CE8C55;dashed=1;dashPattern=6 6;" value="" vertex="1">
          <mxGeometry height="530" width="180" x="800" y="310" as="geometry" />
        </mxCell>
        <mxCell id="asgback" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CE8C55;dashed=1;dashPattern=6 6;" value="" vertex="1">
          <mxGeometry height="530" width="180" x="1092" y="310" as="geometry" />
        </mxCell>
        <mxCell id="albband" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7952CC;dashed=1;dashPattern=6 6;" value="" vertex="1">
          <mxGeometry height="530" width="110" x="482" y="310" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
