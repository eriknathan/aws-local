        <mxCell id="iam-note" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" value="&lt;b&gt;IAM por camada&lt;/b&gt;&lt;br&gt;Frontend: publicar, consultar tarefa e assinar recibo do dono&lt;br&gt;Backend: consumir, persistir, gravar e reconciliar recibo&lt;br&gt;Nenhum papel com PutObjectRetention ou BypassGovernance" vertex="1">
