                <mxCell id="e-front-sqs" value="④ SendMessage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#C02976;fontColor=#C02976;exitX=0.5;exitY=0;entryX=0;entryY=0.25;" parent="1" source="asgfront" target="sqs" edge="1">
