        <mxCell id="e-front-ddb" edge="1" parent="1" source="asgfront" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#3569B0;fontColor=#3569B0;dashed=1;exitX=0.5;exitY=1;entryX=0;entryY=0.8;" target="ddb" value="⑧ GetItem · estado e dono">
          <mxGeometry relative="1" as="geometry">
