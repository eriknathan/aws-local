                <mxCell id="e-back-sqs" value="⑤ Receive / Delete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#C02976;fontColor=#C02976;exitX=1;exitY=0.132;entryX=0;entryY=0.75;" parent="1" source="asgback" target="sqs" edge="1">
