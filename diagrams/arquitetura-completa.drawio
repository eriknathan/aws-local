                </mxCell>
                <mxCell id="e-back-ddb" value="⑥ UpdateItem condicional" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#3569B0;fontColor=#3569B0;exitX=1;exitY=0.443;entryX=0;entryY=0.5;" parent="1" source="asgback" target="ddb" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e-back-s3" value="⑦ PutObject If-None-Match" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#648B20;fontColor=#648B20;exitX=1;exitY=0.736;entryX=0;entryY=0.5;" parent="1" source="asgback" target="s3" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1402" y="700"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e-front-ddb" value="⑧ GetItem · estado e dono" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#3569B0;fontColor=#3569B0;dashed=1;exitX=0.5;exitY=1;entryX=0;entryY=0.8;" parent="1" source="asgfront" target="ddb" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="890" y="858"/>
                            <mxPoint x="1378" y="858"/>
                            <mxPoint x="1378" y="560"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e-sqs-dlq" value="redrive por maxReceiveCount" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#C02976;fontColor=#C02976;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="sqs" target="dlq" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e-s3-download" value="⑨ URL pré-assinada" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Arial;fontSize=11;strokeWidth=1.4;endArrow=blockThin;endSize=6;labelBackgroundColor=#FFFFFF;strokeColor=#648B20;fontColor=#648B20;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="s3" target="dluser" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="flow" value="Fluxo de uma tarefa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CE8C55;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontColor=#C46C1B;fontSize=13;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="170" y="1330" width="895" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="flow-text" value="&lt;b&gt;①&lt;/b&gt; Cliente chama a API por HTTPS no CloudFront, com Web ACL do WAF na frente.&lt;br&gt;&lt;b&gt;②&lt;/b&gt; CloudFront encaminha ao ALB: SG restrito à prefix list do CloudFront e cabeçalho de origem secreto (403 sem ele).&lt;br&gt;&lt;b&gt;③&lt;/b&gt; ALB distribui em HTTP interno para o ASG Frontend, presente nas duas AZs.&lt;br&gt;&lt;b&gt;④&lt;/b&gt; Frontend publica na fila e só então responde 202 + taskId, depois da confirmação da SQS.&lt;br&gt;&lt;b&gt;⑤&lt;/b&gt; Backend recebe por long polling; o DeleteMessage acontece apenas no fim do processamento bem-sucedido.&lt;br&gt;&lt;b&gt;⑥&lt;/b&gt; Backend adquire o lease por escrita condicional e trata reentrega como duplicata, não como nova tarefa.&lt;br&gt;&lt;b&gt;⑦&lt;/b&gt; Grava o recibo com chave determinística e If-None-Match: * — um recibo por tarefa, retido 365 dias.&lt;br&gt;&lt;b&gt;⑧&lt;/b&gt; Confirma COMPLETED + VersionId no DynamoDB; é esse estado que o Frontend lê para responder o cliente.&lt;br&gt;&lt;b&gt;⑨&lt;/b&gt; Download com URL pré-assinada de curta duração, liberada só para o proprietário da tarefa." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
                    <mxGeometry x="190" y="1366" width="855" height="192" as="geometry"/>
                </mxCell>
                <mxCell id="recovery" value="Falhas e recuperação" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#429DB5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontColor=#429DB5;fontSize=13;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="1085" y="1330" width="575" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="recovery-text" value="Falha entre ⑦ e ⑧: a mensagem volta após a visibilidade e o worker reconcilia o recibo já existente em vez de gravar outro.&lt;br&gt;Lease expirado: recuperável por escrita condicional; visibilidade extensível enquanto a tarefa avança.&lt;br&gt;Falha repetida: DLQ por maxReceiveCount, com alarme e redrive só depois da correção.&lt;br&gt;Perda de AZ: ALB e os dois ASGs seguem na AZ restante; capacidade dimensionada para N-1.&lt;br&gt;Testar: duplicata, falha parcial, perda de AZ, retenção mínima, JWT expirado/inválido, acesso entre usuários e URL expirada.&lt;br&gt;O Object Lock protege o recibo, mas não substitui a recuperação do sistema completo." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
                    <mxGeometry x="1105" y="1366" width="535" height="192" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="Leitura do desenho" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontColor=#879196;fontSize=13;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry x="1680" y="1330" width="545" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="legend-text" value="Cores: roxo = entrada web · rosa = mensageria · azul = DynamoDB · verde = recibos no S3 · cinza = rede.&lt;br&gt;Seta cheia: chamada de API, partindo de quem a inicia. Tracejado: associação, fluxo complementar ou redrive.&lt;br&gt;As setas de aplicação saem do grupo (ALB e ASGs), não de uma instância: valem para as duas AZs igualmente.&lt;br&gt;Caixas tracejadas que cruzam as AZs são um único recurso presente nas duas (ALB e cada ASG).&lt;br&gt;O usuário aparece duas vezes de propósito: a entrada ① e o download ⑨ são caminhos distintos.&lt;br&gt;Arco na linha indica cruzamento sem ligação." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
                    <mxGeometry x="1700" y="1366" width="505" height="192" as="geometry"/>
                </mxCell>
                <mxCell id="footer" value="Arquitetura completa — itens 1–6 de docs/melhorias.md já implementados em terraform/ (idempotência, retenção S3, WAF/HTTPS/CloudFront, VPC endpoints, scaling + alarmes, Cognito). Validação DNS do ACM é manual, domínio fora do Route53 — ver docs/dns-validacao.md. Item 3 não valida contra o Floci (CloudFront crasha o provider) — ver terraform/README.md." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#6B7885;" parent="1" vertex="1">
                    <mxGeometry x="170" y="1578" width="2055" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="asgfront" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CE8C55;dashed=1;dashPattern=6 6;" parent="1" vertex="1">
                    <mxGeometry x="800" y="310" width="180" height="530" as="geometry"/>
                </mxCell>
                <mxCell id="asgback" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CE8C55;dashed=1;dashPattern=6 6;" parent="1" vertex="1">
                    <mxGeometry x="1092" y="310" width="180" height="530" as="geometry"/>
                </mxCell>
                <mxCell id="albband" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7952CC;dashed=1;dashPattern=6 6;" parent="1" vertex="1">
                    <mxGeometry x="482" y="310" width="110" height="530" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>