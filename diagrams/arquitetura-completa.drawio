                <mxCell id="iam-note" value="&lt;b&gt;IAM por camada&lt;/b&gt;&lt;br&gt;Frontend: valida JWT do Cognito · publica, consulta tarefa e assina recibo do dono&lt;br&gt;Backend: consumir, persistir, gravar e reconciliar recibo&lt;br&gt;Nenhum papel com PutObjectRetention ou BypassGovernance" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
