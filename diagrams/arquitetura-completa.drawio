                <mxCell id="s3-label" value="&lt;b&gt;S3 · flowqueue-receipts-*&lt;/b&gt;&lt;br&gt;Object Lock COMPLIANCE · 365 dias (nem a raiz apaga antes do prazo)&lt;br&gt;Versionamento · Block Public Access · SSE-S3&lt;br&gt;Chave determinística por tarefa · PutObject com If-None-Match: *&lt;br&gt;Política do bucket barra downgrade de modo e bypass de governança" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
                    <mxGeometry x="1595" y="620" width="545" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="dluser" value="" style="sketch=0;html=1;outlineConnect=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;fillColor=#7D8998;gradientColor=none;strokeColor=none;aspect=fixed;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="776" width="48" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="dluser-label" value="mesmo usuário de ①" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=10;align=center;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#6B7885;" parent="1" vertex="1">
                    <mxGeometry x="1495" y="885" width="100" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="dluser-note" value="&lt;b&gt;Download do recibo&lt;/b&gt;&lt;br&gt;Cliente autentica no Cognito (login) e envia o JWT ao Frontend.&lt;br&gt;Frontend valida o JWT (JWKS), consulta dono/estado no DynamoDB e assina uma URL GET curta (≈5 min).&lt;br&gt;Bucket segue privado: download direto do S3 pela URL assinada, sem VPC endpoint no caminho." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
                    <mxGeometry x="1595" y="772" width="455" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="cognito" value="" style="sketch=0;html=1;outlineConnect=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;fillColor=#DD344C;gradientColor=none;strokeColor=none;aspect=fixed;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="926" width="50" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="cognito-label" value="&lt;b&gt;Cognito · User Pool&lt;/b&gt;&lt;br&gt;Login por e-mail (InitiateAuth) · app client sem secret&lt;br&gt;Frontend valida o JWT localmente via JWKS — sem chamada de API por request, sem IAM extra pro Cognito." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
                    <mxGeometry x="1595" y="922" width="545" height="80" as="geometry"/>
                </mxCell>
