        <mxCell id="s3-label" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" value="&lt;b&gt;S3 · flowqueue-receipts-*&lt;/b&gt;&lt;br&gt;Object Lock COMPLIANCE · 365 dias (nem a raiz apaga antes do prazo)&lt;br&gt;Versionamento · Block Public Access · SSE-S3&lt;br&gt;Chave determinística por tarefa · PutObject com If-None-Match: *&lt;br&gt;Política do bucket barra downgrade de modo e bypass de governança" vertex="1">
          <mxGeometry height="100" width="545" x="1520" y="726" as="geometry" />
        </mxCell>
        <mxCell id="dluser" parent="1" style="sketch=0;html=1;outlineConnect=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;fillColor=#7D8998;gradientColor=none;strokeColor=none;aspect=fixed;" value="" vertex="1">
          <mxGeometry height="48" width="48" x="1435" y="910" as="geometry" />
        </mxCell>
        <mxCell id="dluser-label" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=10;align=center;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#6B7885;" value="mesmo usuário de ①" vertex="1">
          <mxGeometry height="30" width="100" x="1409" y="962" as="geometry" />
        </mxCell>
        <mxCell id="dluser-note" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" value="&lt;b&gt;Download do recibo&lt;/b&gt;&lt;br&gt;O frontend valida identidade e proprietário, consulta o estado e assina uma URL GET curta (≈5 min).&lt;br&gt;O bucket segue privado: o cliente baixa direto do S3 pela URL assinada, sem VPC endpoint no caminho." vertex="1">
          <mxGeometry height="80" width="545" x="1520" y="906" as="geometry" />
        </mxCell>
        <mxCell id="ops" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#879196;fontSize=12;fontFamily=Arial;dashed=1;dashPattern=6 6;" value="Operação e observabilidade · serviços regionais alcançados pelos endpoints" vertex="1">
