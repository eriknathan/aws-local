                <mxCell id="cw-label" value="&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;Logs correlacionados por taskId · métricas de escala&lt;br&gt;Alarmes: idade da fila, DLQ, 5xx do ALB, erro de worker → SNS" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#3F4A56;" parent="1" vertex="1">
