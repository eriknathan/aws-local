        <mxCell id="asgs" value="&lt;b&gt;Exatamente dois Auto Scaling Groups&lt;/b&gt;&lt;br&gt;ASG Frontend = EC2 Frontend A + B &amp;nbsp; | &amp;nbsp; ASG Backend = EC2 Backend A + B&lt;br&gt;Um grupo por camada, abrangendo as duas sub-redes privadas correspondentes." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;fillColor=#FFF9F0;strokeColor=#EACDA7;spacing=12;align=left;" vertex="1" parent="vpc">
          <mxGeometry x="30" y="865" width="1020" height="115" as="geometry" />
        </mxCell>
        <mxCell id="sqs" value="&lt;b&gt;Amazon SQS&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526581&quot;&gt;Fila principal + DLQ&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#C82A73;spacing=12;align=center;spacingLeft=58;" vertex="1" parent="managed">
          <mxGeometry x="30" y="65" width="450" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sqs-icon" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;fillColor=#C82A73;strokeColor=none;gradientColor=none;aspect=fixed;" vertex="1" parent="sqs">
          <mxGeometry x="12" y="32" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ddb" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526581&quot;&gt;Compartilhado pelos backends A e B&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#3569B0;spacing=12;align=center;spacingLeft=58;" vertex="1" parent="managed">
          <mxGeometry x="30" y="195" width="450" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ddb-icon" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#3569B0;strokeColor=none;gradientColor=none;aspect=fixed;" vertex="1" parent="ddb">
          <mxGeometry x="12" y="32" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ssm" value="&lt;b&gt;Session Manager&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526581&quot;&gt;Administração das quatro EC2&lt;br&gt;Sem SSH/RDP ou bastion&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#58667C;spacing=12;align=center;spacingLeft=58;" vertex="1" parent="managed">
          <mxGeometry x="30" y="365" width="450" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ssm-icon" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;fillColor=#58667C;strokeColor=none;gradientColor=none;aspect=fixed;" vertex="1" parent="ssm">
          <mxGeometry x="12" y="37" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="params" value="&lt;b&gt;Parameter Store&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526581&quot;&gt;Configurações e segredos&lt;br&gt;Consumidos pelas quatro EC2&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#58667C;spacing=12;align=center;spacingLeft=58;" vertex="1" parent="managed">
          <mxGeometry x="30" y="505" width="450" height="110" as="geometry" />
        </mxCell>
        <mxCell id="params-icon" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;fillColor=#58667C;strokeColor=none;gradientColor=none;aspect=fixed;" vertex="1" parent="params">
          <mxGeometry x="12" y="37" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="opsflow" value="&lt;b&gt;9 · Acesso operacional&lt;/b&gt;&lt;br&gt;&lt;br&gt;Operador → Session Manager ↔ agente SSM nas EC2.&lt;br&gt;Aplicações nas EC2 → Parameter Store.&lt;br&gt;&lt;br&gt;As conexões de serviço são iniciadas pelas instâncias; não exigem portas administrativas de entrada." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#CDD5E1;spacing=12;align=left;verticalAlign=top;" vertex="1" parent="managed">
          <mxGeometry x="30" y="660" width="450" height="200" as="geometry" />
        </mxCell>
        <mxCell id="natflow" value="&lt;b&gt;8 · Saída por AZ&lt;/b&gt;&lt;br&gt;Sub-redes privadas → NAT da mesma AZ → IGW.&lt;br&gt;Destino: internet e endpoints públicos dos serviços AWS.&lt;br&gt;Sub-redes públicas: rota 0.0.0.0/0 → IGW.&lt;br&gt;Privadas A/B: rota 0.0.0.0/0 → NAT A/B." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;fillColor=none;strokeColor=none;spacing=12;rounded=0;align=left;spacing=0;fontSize=14;fontColor=#526581;" vertex="1" parent="managed">
          <mxGeometry x="30" y="880" width="450" height="120" as="geometry" />
        </mxCell>
        <mxCell id="routehint" value="NAT A e B usam o IGW compartilhado para saída; caminhos descritos no quadro “8 · Saída por AZ”.&lt;br&gt;Linhas roxas = entrada web; cinza tracejado = saída iniciada pelas EC2. Ligações de aplicação: aba 01." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;fillColor=none;strokeColor=none;spacing=12;rounded=0;align=left;spacing=0;fontSize=14;fontColor=#526581;" vertex="1" parent="1">
          <mxGeometry x="60" y="1285" width="1660" height="55" as="geometry" />
        </mxCell>
        <mxCell id="future" value="&lt;b&gt;Melhorias futuras — não representadas como recursos implantados&lt;/b&gt;&lt;br&gt;VPC Endpoints (SQS, DynamoDB, SSM) • Alarmes CloudWatch • Definição de retry/redrive • WAF&lt;br&gt;Pontos a detalhar: restrição da origem ALB ao CloudFront, permissões IAM e parâmetros de disponibilidade/capacidade." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;fillColor=#FFFBEF;strokeColor=#DCC78B;spacing=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="1350" width="1640" height="85" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
