        <mxCell id="front-note" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;fillColor=none;strokeColor=none;spacing=12;rounded=0;align=left;spacing=0;fontSize=14;fontColor=#526581;" value="Frontend publica o trabalho e responde à requisição.&lt;br&gt;O processamento de negócio ocorre de forma assíncrona." vertex="1">
          <mxGeometry height="70" width="310" x="60" y="660" as="geometry" />
        </mxCell>
        <mxCell id="worker-note" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#EACAD9;spacing=12;align=left;verticalAlign=top;spacing=20;" value="&lt;b&gt;Ciclo do consumidor&lt;/b&gt;&lt;br&gt;&lt;br&gt;O backend busca mensagens na fila, processa e persiste os dados.&lt;br&gt;Após sucesso, confirma a remoção com &lt;b&gt;DeleteMessage&lt;/b&gt;.&lt;br&gt;Sem remoção, a mensagem pode reaparecer após o visibility timeout." vertex="1">
          <mxGeometry height="190" width="760" x="870" y="440" as="geometry" />
        </mxCell>
        <mxCell id="dlq-note" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;fillColor=none;strokeColor=none;spacing=12;rounded=0;align=left;spacing=0;fontSize=14;fontColor=#526581;" value="Falhas repetidas → DLQ conforme &lt;b&gt;maxReceiveCount&lt;/b&gt;.&lt;br&gt;Investigação e eventual reprocessamento posterior.&lt;br&gt;Limite de tentativas ainda não definido na documentação." vertex="1">
          <mxGeometry height="100" width="650" x="750" y="790" as="geometry" />
        </mxCell>
        <mxCell id="ha-note" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;fillColor=#FFF9F0;strokeColor=#EACDA7;spacing=12;align=left;" value="&lt;b&gt;Escala independente&lt;/b&gt;&lt;br&gt;ASG Frontend: demanda web.&lt;br&gt;ASG Backend: demanda de processamento.&lt;br&gt;A fila absorve picos e desacopla as camadas." vertex="1">
          <mxGeometry height="150" width="310" x="60" y="790" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;fillColor=none;strokeColor=none;spacing=12;rounded=0;align=left;spacing=0;fontSize=14;fontColor=#526581;" value="&lt;b&gt;Leitura:&lt;/b&gt; setas representam chamadas iniciadas pelo componente de origem; vermelho tracejado = redrive para a DLQ.&lt;br&gt;SQS e DynamoDB são serviços regionais fora da VPC. CloudFront é global. ASGs e ALB são únicos, com presença em ambas as AZs." vertex="1">
          <mxGeometry height="60" width="1680" x="40" y="980" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
