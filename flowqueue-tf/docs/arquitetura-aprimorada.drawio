                <mxCell id="state-icon" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#24344B;fillColor=#3B48CC;strokeColor=none;spacing=12;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;gradientColor=none;aspect=fixed;" parent="state" vertex="1">
