                    <mxGeometry x="12" y="32" width="36" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="publish" value="SendMessage" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#24344B;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;strokeColor=#C02976;fontColor=#C02976;strokeWidth=1.6;endArrow=block;endSize=7;labelBackgroundColor=#FFFFFF;whiteSpace=nowrap;" parent="1" source="front" target="queue" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
