                <mxCell id="eptext" value="&lt;b&gt;Gateway:&lt;/b&gt; S3 e DynamoDB → rotas das sub-redes privadas&lt;br&gt;&lt;b&gt;Interface:&lt;/b&gt; SQS e serviços necessários ao SSM → presença A/B, DNS privado e SG HTTPS&lt;br&gt;Aplicações usam HTTPS; políticas de endpoint + IAM limitam recursos e ações." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#24344B;fillColor=none;strokeColor=none;spacing=12;align=left;fontSize=13;spacing=0;" parent="1" vertex="1">
