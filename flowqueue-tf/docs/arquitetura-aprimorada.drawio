                </mxCell>
                <mxCell id="bucket" value="&lt;b&gt;5 · S3&lt;/b&gt;&lt;br&gt;Grava recibo com chave estável&lt;br&gt;COMPLIANCE / 365 dias" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#24344B;fillColor=#FFFFFF;strokeColor=#CAD4E0;spacing=12;rounded=1;arcSize=8;align=left;spacingLeft=60;" parent="1" vertex="1">
