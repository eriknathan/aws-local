        <mxCell id="receipt-download" value="Download HTTPS · URL pré-assinada de curta duração · VersionId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;whiteSpace=nowrap;fontFamily=Arial;fontSize=12;strokeColor=#648B20;fontColor=#648B20;strokeWidth=1.3;endArrow=classic;endSize=7;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="users" target="s3">
