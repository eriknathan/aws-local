        </mxCell>
        <mxCell id="download-note" value="&lt;b&gt;Acesso ao recibo&lt;/b&gt;&lt;br&gt;Frontend valida identidade e proprietário,&lt;br&gt;consulta estado e assina URL (ex.: 5 min).&lt;br&gt;Bucket privado permite leitura assinada;&lt;br&gt;não exigir VPC endpoint nesse download." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#333333;fillColor=none;strokeColor=none;fontSize=13;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1765" y="1050" width="345" height="100" />
        </mxCell>
        <mxCell id="operational-note" value="EC2 → SSM / parâmetros por endpoints. IAM separado para frontend, backend e operação; recursos e ações limitados.&lt;br&gt;CloudWatch coleta logs com taskId e orienta alarmes/escala. Ligações operacionais omitidas para legibilidade." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#333333;fillColor=none;strokeColor=none;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="395" y="1310" width="1085" height="40" />
        </mxCell>
        <mxCell id="processing" value="Processamento confiável" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#333333;fillColor=none;strokeColor=none;strokeColor=#CE8C55;align=left;verticalAlign=top;spacingLeft=38;spacingTop=8;fontColor=#CE8C55;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="1430" width="790" height="160" />
        </mxCell>
        <mxCell id="processing-text" value="1. Frontend publica; retorna 202 + taskId após confirmação.&lt;br&gt;2. Worker adquire lease por escrita condicional; trata duplicatas.&lt;br&gt;3. Grava recibo com chave estável / If-None-Match: *.&lt;br&gt;4. Confirma COMPLETED + VersionId; só então DeleteMessage.&lt;br&gt;Falha após upload: reconciliar recibo existente antes de repetir.&lt;br&gt;Visibilidade extensível, lease recuperável e redrive controlado." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#333333;fillColor=none;strokeColor=none;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="1468" width="745" height="110" />
        </mxCell>
        <mxCell id="security" value="Segurança e recuperação" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#333333;fillColor=none;strokeColor=none;strokeColor=#429DB5;align=left;verticalAlign=top;spacingLeft=38;spacingTop=8;fontColor=#429DB5;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="1430" width="750" height="160" />
        </mxCell>
        <mxCell id="security-text" value="Frontend: publicar, consultar tarefa e assinar recibo autorizado.&lt;br&gt;Backend: consumir, persistir e gravar/reconciliar recibos.&lt;br&gt;Worker sem alteração da retenção/configuração do bucket.&lt;br&gt;Testar: duplicatas, falha parcial, perda de AZ e restauração PITR.&lt;br&gt;Validar: retenção mínima, acesso entre usuários e URL expirada.&lt;br&gt;Retenção S3 não substitui recuperação do sistema completo." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#333333;fillColor=none;strokeColor=none;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="870" y="1468" width="710" height="110" />
        </mxCell>
        <mxCell id="legend" value="Leitura do desenho" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#333333;fillColor=none;strokeColor=none;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=38;spacingTop=8;fontColor=#999999;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1625" y="1430" width="565" height="160" />
        </mxCell>
        <mxCell id="legend-text" value="Roxo: entrada web · Rosa: mensageria&lt;br&gt;Azul: DynamoDB · Verde: recibos S3&lt;br&gt;Setas de API: origem inicia a chamada.&lt;br&gt;Tracejado: associação / fluxo complementar / redrive.&lt;br&gt;Chamadas AWS das EC2 passam pelos endpoints.&lt;br&gt;Entrada pública do ALB usa IGW; ALB → EC2 é interno." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#333333;fillColor=none;strokeColor=none;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1645" y="1468" width="525" height="110" />
        </mxCell>
        <mxCell id="footer" value="Proposta de arquitetura · Uma única página editável · Arquivo de referência preservado · Não representa recursos já implantados" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=13;fontColor=#333333;fillColor=none;strokeColor=none;fontSize=12;align=left;fontColor=#666666;" vertex="1" parent="1">
